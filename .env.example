# Copy to .env and adjust. Every value has a working local default baked
# into the code, so an empty .env is fine for browsing; EVE SSO login is the
# only feature that needs real credentials.

# Postgres (defaults to the docker-compose instance).
# DATABASE_URL=postgres://mutamarket:mutamarket@127.0.0.1:5433/mutamarket

# EVE SSO application, created at https://developers.eveonline.com.
# Set the application's callback URL to the value of EVE_CALLBACK_URL.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=http://127.0.0.1:3000/eve/callback

# Override for tests/mocks only; leave unset for the real APIs.
# ESI_BASE_URL=https://esi.evetech.net
# EVE_SSO_BASE_URL=https://login.eveonline.com

# Account-linking OAuth apps (all optional; the /twitch, /discord and
# /patreon flows just fail at the provider without them). Redirect URIs
# must match the app registration; DISCORD_BOT_TOKEN is the bot used to
# open the DM channel stored on link.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://127.0.0.1:3000/twitch/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:3000/discord/callback
# DISCORD_BOT_TOKEN=
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_REDIRECT_URI=http://127.0.0.1:3000/patreon/callback

# Background ingestion loops (contracts across all k-space regions every
# 30 minutes, auction bids every 5, PLEX history daily, module value
# estimates every 5) - on by default like the legacy scheduler. Set to
# false to avoid the ESI and AI-server traffic during development;
# `cargo run --bin contracts_sync` and `cargo run --bin estimate_values`
# cover one-shot runs.
# SCHEDULER_ENABLED=false

# The AI estimation server (the FastAPI app from the legacy estimators/
# project) serving one trained model per abyssal type; estimates stay
# untouched while it is unreachable. AI_COUNT caps the modules refreshed
# per scheduled estimate pass. Defaults mirror the legacy config/ai.php.
# AI_HOST=0.0.0.0
# AI_PORT=6969
# AI_COUNT=4000
