# Copy to .env. Every value has a working local default; only EVE SSO
# login needs real credentials.

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://mutamarket:mutamarket@127.0.0.1:5433/mutamarket
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# EVE SSO app (https://developers.eveonline.com). The callback goes
# through the shared origin (the SvelteKit dev server), never Axum's port.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=http://localhost:5173/eve/callback

# Account-linking OAuth apps; each flow just fails at the provider when
# unset. DISCORD_BOT_TOKEN opens the DM channel stored on link.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://127.0.0.1:3000/twitch/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:3000/discord/callback
# DISCORD_BOT_TOKEN=
# Webhook the hourly admin-scope check alerts on; unset only checks.
# DISCORD_ALERT_WEBHOOK=
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_REDIRECT_URI=http://127.0.0.1:3000/patreon/callback
# PATREON_ACCESS_TOKEN=
# PATREON_PREMIUM_TIERS=

# Background jobs (ESI ingestion, estimates, sweeps); off keeps a dev
# stack quiet. AI_COUNT caps modules re-estimated per pass.
# SCHEDULER_ENABLED=false
# AI_COUNT=4000
# EVE_STRUCTURES_CHARACTER_ID=

# Sidebar partner links; unset ones hide. MARKEEDRAGON_STORE_URL is where
# the synced store ads send buyers (your affiliate link; plain store
# when unset).
# ABYSSAL_TRADING_INVITE=
# DISCORD_INVITE=
# ECTRADE_INVITE=
# MARKEEDRAGON_STORE_URL=

# Premium pricing and the in-game donation character.
# APP_PREMIUM_COST=100000000
# APP_PREMIUM_YEARLY_COST=1000000000
# APP_PREMIUM_CHARACTER=MutaMate

# Outward EVE mail: unset only simulates; production sets esi plus the
# sending character.
# NOTIFY_DELIVERY=esi
# NOTIFY_SENDER_CHARACTER_ID=

# APP_ENV=local marks a developer machine: OpenGraph cards re-render on
# every request and cookies skip the Secure flag. Unset means production.
# APP_ENV=local
# OG_CACHE_DIR=storage/app/public/og
# IMAGE_SERVER_BASE_URL=https://images.evetech.net

# Tests and mocks only.
# ESI_BASE_URL=https://esi.evetech.net
# EVE_SSO_BASE_URL=https://login.eveonline.com
# TEST_DATABASE_URL=
# LEGACY_DATABASE_URL=mysql://root@127.0.0.1:3306/mutamarket

# Compose stack (http://localhost:5100): SDE_FORCE=1 reseeds the SDE;
# the node server reads ORIGIN and AXUM_URL; PUBLIC_* reach the frontend.
# SDE_FORCE=
# ORIGIN=https://mutamarket.com
# AXUM_URL=http://127.0.0.1:3000
# PUBLIC_PATREON_LINK=
# PUBLIC_KOFI_LINK=
# PUBLIC_MARKEEDRAGON_URL=
# PUBLIC_MARKEEDRAGON_CODE=
