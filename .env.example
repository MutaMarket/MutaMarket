# Copy to .env and adjust. Every value has a working local default baked
# into the code, so an empty .env is fine for browsing; EVE SSO login is the
# only feature that needs real credentials.

# Postgres (defaults to the docker-compose instance).
# DATABASE_URL=postgres://mutamarket:mutamarket@127.0.0.1:5433/mutamarket

# JSON API listen address. The SvelteKit dev proxy (frontend/, port 5173)
# and the production reverse proxy point at it; the browser always goes
# through the shared origin so cookies stay same-origin.
# BIND_ADDR=127.0.0.1:3000

# The full composed stack (`docker compose up --build`) always serves on
# http://localhost:5100 and bootstraps the SDE automatically (skipped
# when the seeded build is current; SDE_FORCE=1 reseeds).
# SDE_FORCE=

# Production SvelteKit node server settings (not read by the Rust binary):
# ORIGIN is the public origin for adapter-node, AXUM_URL where SSR loads
# reach the API (defaults to http://127.0.0.1:3000).
# ORIGIN=https://mutamarket.com
# AXUM_URL=http://127.0.0.1:3000

# EVE SSO application, created at https://developers.eveonline.com.
# Set the application's callback URL to the value of EVE_CALLBACK_URL.
# The callback must go through the shared origin (the SvelteKit dev
# server locally), not Axum's port, so the session cookie lands on the
# origin the browser actually uses.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=http://localhost:5173/eve/callback

# Override for tests/mocks only; leave unset for the real APIs.
# ESI_BASE_URL=https://esi.evetech.net
# EVE_SSO_BASE_URL=https://login.eveonline.com

# Account-linking OAuth apps (all optional; the /twitch, /discord and
# /patreon flows just fail at the provider without them). Redirect URIs
# must match the app registration; DISCORD_BOT_TOKEN is the bot used to
# open the DM channel stored on link.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://127.0.0.1:3000/twitch/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:3000/discord/callback
# DISCORD_BOT_TOKEN=
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_REDIRECT_URI=http://127.0.0.1:3000/patreon/callback

# Background ingestion loops (contracts across all k-space regions every
# 30 minutes, auction bids every 5, PLEX history daily, module value
# estimates every 5) - on by default like the legacy scheduler. Set to
# false to avoid the ESI traffic during development;
# `cargo run --bin contracts_sync` and `cargo run --bin estimate_values`
# cover one-shot runs.
# SCHEDULER_ENABLED=false

# AI_COUNT caps the modules refreshed per scheduled estimate pass
# (estimation runs in-process on the native models trained by
# `cargo run --bin train_estimators`; the name mirrors the legacy
# config/ai.php).
# AI_COUNT=4000
# 30 minutes, auction bids every 5, PLEX history daily, character assets
# and contracts every 5, the stale-asset-import sweeper every minute, and
# the public structure sweep daily) - on by default like the legacy
# scheduler. Set to false to avoid the ESI traffic during development;
# `cargo run --bin contracts_sync` covers one-shot runs.

# Character whose token resolves the daily public structure sweep (the
# legacy services.eveonline.character_id). Must have logged in with the
# structures scope; unset skips the sweep.
# EVE_STRUCTURES_CHARACTER_ID=

# Current store sale percentages surfaced by /api/omega-calculator (the
# legacy services.markeedragon.sale / services.evestore.sale). Raw
# strings passed straight through to the page; unset means null.
# MARKEEDRAGON_SALE=
# EVESTORE_SALE=

# Partner Discord invite links on the sidebar (legacy
# services.abyssal_trading.invite / services.discord.invite /
# services.ectrade.invite). The sidebar hides unset invites and the
# member-count job skips itself when none are set; member counts are
# refreshed daily by the discord-member-counts scheduler job.
# ABYSSAL_TRADING_INVITE=
# DISCORD_INVITE=
# ECTRADE_INVITE=

# Discord webhook the hourly admin-scope check alerts when the service
# character is missing admin-login scopes (legacy
# services.discord.alert_webhook). Unset means check-only, no alert.
# DISCORD_ALERT_WEBHOOK=

# Premium pricing and the in-game donation target (legacy config/app.php
# app.premium_cost / app.premium_yearly_cost / app.premium_character).
# Surfaced to the frontend through /api/sidebar.
# APP_PREMIUM_COST=100000000
# APP_PREMIUM_YEARLY_COST=1000000000
# APP_PREMIUM_CHARACTER=MutaMate

# Log verbosity for the structured tracing output (tracing_subscriber
# EnvFilter syntax). Defaults to "info".
# RUST_LOG=mutamarket=debug
