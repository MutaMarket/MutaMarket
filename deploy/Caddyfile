# Production shared origin: backend paths and every mutation go to Axum,
# page GETs go to the SvelteKit node server. Keep the prefix lists in
# sync with frontend/proxy-paths.ts (the dev proxy reads that file).
#
# Used by docker-compose.prod.yml: the api and frontend containers are
# the upstreams, and Caddy holds the TLS certificate for the domain,
# STACK_HOST from .env (the host of STACK_ORIGIN).

{$STACK_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@axum path /api/* /eve /eve/* /twitch /twitch/* /discord /discord/* \
		/patreon /patreon/* /og/* /img/* /ws /display /logout /auth/* \
		/sitemap.xml
	reverse_proxy @axum api:3000

	@mutations not method GET HEAD
	reverse_proxy @mutations api:3000

	reverse_proxy frontend:3000
}
