# The composed shared origin on :5100: backend paths and every mutation
# go to the API container, page GETs to the SvelteKit node server. Keep
# the prefix list in sync with frontend/proxy-paths.ts (and the
# production Caddyfile beside this file).

:5100 {
	encode zstd gzip
	@axum path /api/* /eve /eve/* /twitch /twitch/* /discord /discord/* \
		/patreon /patreon/* /og/* /img/* /ws /display /logout /auth/* \
		/sitemap.xml
	reverse_proxy @axum api:3000

	@mutations not method GET HEAD
	reverse_proxy @mutations api:3000

	reverse_proxy frontend:3000
}
